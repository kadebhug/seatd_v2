{
  "name": "@seatd/typescript-seatd-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "fmt": "prettier --write .",
    "generate": "node scripts/generate.mjs",
    "lint": "npm run generate && tsc --noEmit",
    "test": "npm run generate && tsc --noEmit",
    "build": "npm run generate && tsc --project tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
