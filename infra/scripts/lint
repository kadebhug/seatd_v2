#!/usr/bin/env bash
set -euo pipefail

docker compose -f infra/compose.yml config >/dev/null
for migration in infra/database/migrations/*.up.sql; do
  down="${migration%.up.sql}.down.sql"
  if [[ ! -f "$down" ]]; then
    printf 'error: missing down migration for %s\n' "$migration" >&2
    exit 1
  fi
done
