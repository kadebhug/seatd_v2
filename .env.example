# Copy-on-bootstrap development defaults. Never place secrets in this file.
SEATD_ENV=local
SEATD_LOG_LEVEL=debug
SEATD_SHUTDOWN_TIMEOUT=10s

SEATD_API_PORT=8080
SEATD_WORKER_PORT=8081
SEATD_REALTIME_PORT=8082
SEATD_WEB_PORT=3000
SEATD_GUEST_PORT=5173
SEATD_API_BASE_URL=http://localhost:8080
VITE_SEATD_API_BASE_URL=http://localhost:8080
SEATD_DATABASE_URL=postgres://seatd:seatd@localhost:5432/seatd?sslmode=disable

# Local/test services default to console tracing. Staging/production export
# traces only when OTLP env vars configure a collector endpoint.
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
SEATD_TRACING_SAMPLE_RATIO=1
SEATD_TRACING_DB_STATEMENTS=false

# Secrets must be injected by the shell, a local untracked .env.local file, or
# the deployment platform's secret manager. Add app-specific variables in the
# phase that introduces the application.
SEATD_OIDC_ISSUER=https://YOUR_TENANT.auth0.com
SEATD_OIDC_CLIENT_ID=...from the app dashboard...
SEATD_OIDC_CLIENT_SECRET=...from the app dashboard...
SEATD_WEB_SESSION_SECRET=paste-a-long-random-string-here-at-least-32-chars